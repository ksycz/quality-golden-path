// TypeScript settings. Used only for type checking (npm run typecheck); Vitest and Node run the code.
{
  "compilerOptions": {
    "target": "ES2022",                 // modern JavaScript, matches Node 22
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,                     // all strict type checks on
    "noUncheckedIndexedAccess": true,   // array[i] may be undefined: forces us to handle it
    "exactOptionalPropertyTypes": true, // optional means "may be missing", not "may be undefined"
    "skipLibCheck": true,               // don't type-check node_modules
    "noEmit": true,                     // check only, never write .js files
    "types": ["node"],                  // Node's types, for the server; nothing else global
    "allowImportingTsExtensions": true, // imports end in .ts, so Node can run the server without a build
    "erasableSyntaxOnly": true          // only TypeScript that Node can strip: no enums or namespaces
  },
  "include": ["src", "tests", "smoke", "e2e", "playwright.config.ts"]
}
