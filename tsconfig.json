// TypeScript settings. Used only for type checking (npm run typecheck); Vitest runs the code.
{
  "compilerOptions": {
    "target": "ES2022",                 // modern JavaScript, matches Node 22
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,                     // all strict type checks on
    "noUncheckedIndexedAccess": true,   // array[i] may be undefined: forces us to handle it
    "exactOptionalPropertyTypes": true, // optional means "may be missing", not "may be undefined"
    "skipLibCheck": true,               // don't type-check node_modules
    "noEmit": true,                     // check only, never write .js files
    "types": []                         // no global types unless imported
  },
  "include": ["src", "tests"]
}
