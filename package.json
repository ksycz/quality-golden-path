{
  "name": "quality-golden-path",
  "version": "0.1.0",
  "private": true,
  "description": "Demo: quality standards for teams where coding agents write the code. Synthetic payment service, made-up data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node src/server.ts",
    "smoke": "playwright test --project=smoke",
    "e2e": "node scripts/e2e.mjs",
    "mutation": "stryker run",
    "mutation:changed": "node scripts/mutation-changed.mjs",
    "check:risks": "node scripts/risk-check.mjs",
    "check:names": "node scripts/name-guard.mjs",
    "check:title": "node scripts/pr-title.mjs",
    "check:description": "node scripts/pr-description.mjs",
    "gates": "node scripts/gates.mjs",
    "check:data": "node scripts/data-scan.mjs",
    "check:secrets": "node scripts/secrets-scan.mjs",
    "check:size": "node scripts/pr-size.mjs",
    "check:tests": "node scripts/test-guard.mjs",
    "check:deps": "node scripts/new-dependency.mjs",
    "dashboard": "node dashboard/build.ts",
    "risk-coverage": "stryker run && node dashboard/risk-coverage.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.6",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "fast-check": "4.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "qs": "^6.16.1"
  }
}
